# Copy to .env. Never commit real credentials.
ADMIN_PASSWORD=
YOUTUBE_API_KEY=
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
# YouTube playlist media is the primary workflow; adapter remains experimental.
EXPERIMENTAL_YOUTUBE=true
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
MEDIA_DIR=./media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
# Optional Netscape-format cookies file for YouTube verification challenges.
YTDLP_COOKIES_FILE=
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
CACHE_MAX_MB=4096
UDP_BASE_PORT=19000
