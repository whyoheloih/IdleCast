{
  "name": "idlecast",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:browser": "tsx tests/browser.e2e.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/index.cjs",
    "desktop:dev": "pnpm build && electron .",
    "desktop:dist": "pnpm build && pnpm build:server && node scripts/prepare-desktop.mjs && node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.idlecast.desktop",
    "productName": "IdleCast",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "idlecast/dist"
      },
      {
        "from": "media/loading-cat.gif",
        "to": "idlecast/media/loading-cat.gif"
      },
      {
        "from": "dist-server/index.cjs",
        "to": "server/index.cjs"
      },
      {
        "from": "desktop-resources/tools",
        "to": "tools"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "IdleCast-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "IdleCast-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "whyoheloih",
        "repo": "IdleCast",
        "releaseType": "release"
      }
    ]
  },
  "description": "A self-hosted 24/7 YouTube and Twitch playlist broadcaster.",
  "author": "IdleCast"
}
